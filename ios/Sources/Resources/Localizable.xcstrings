      }
    },
    "Dafür wird der YouTube-API-Schlüssel gebraucht (Playlists ohne oEmbed, Ausweichweg für Videos). Er fehlt in Config/Secrets.xcconfig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs the YouTube API key (playlists without oEmbed, fallback for videos). It is missing in Config/Secrets.xcconfig."
          }
        }
      }
    },
    "Das Kind darf im Kanal stöbern; neue Videos erscheinen ohne Einzelprüfung, nur mit Risikofilter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The child may browse the channel; new videos appear without individual review, only with the risk filter."
          }
        }
      }
    },
    "Das Kind hat nur ein Stichwort geschickt und dabei nichts Fremdes gesehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The child only sent a keyword and saw nothing unfamiliar."
          }
        }
      }
    },
    "Das Kind möchte mehr wie dieses freigegebene Video.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The child wants more like this approved video."
          }
        }
      }
    },
    "Das Kind sieht nur Videos dieses Kanals, die ihr einzeln freigegeben habt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The child sees only videos of this channel that you approved individually."
          }
        }
      }
    },
    "Das Video lädt nicht. Ist das Internet an?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video does not load. Is the internet on?"
          }
        }
      }
    },
    "Das geht leider nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, that is not possible."
          }
        }
      }
    },
    "Das ging nicht: Der Wunsch ist schon entschieden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not work: the wish has already been decided."
          }
        }
      }
    },
    "Das hast du dir schon gewünscht. Deine Eltern schauen es sich an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already wished for that. Your parents are looking at it."
          }
        }
      }
    },
    "Das hat nicht geklappt. Ist das Internet an?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not work. Is the internet on?"
          }
        }
      }
    },
    "Das hat nicht geklappt. Sag deinen Eltern Bescheid.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not work. Tell your parents."
          }
        }
      }
    },
    "Das ist kein YouTube-Link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a YouTube link."
          }
        }
      }
    },
    "Das ist kein unterstützter Link. Möglich: YouTube (Kanal, Video, Playlist) oder PeerTube (Video, Kanal).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link is not supported. Possible: YouTube (channel, video, playlist) or PeerTube (video, channel)."
          }
        }
      }
    },
    "Das klappt gerade nicht. Sag deinen Eltern Bescheid.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not working right now. Tell your parents."
          }
        }
      }
    },
    "Daten konnten nicht geladen werden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data could not be loaded"
          }
        }
      }
    },
    "Datenschutz & Support": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & support"
          }
        }
      }
    },
    "Datenschutz: Alles bleibt auf dem Gerät. Keine Konten, keine Werbung, kein Tracking. Die App richtet sich auch an Kinder unter 13 und erhebt keine personenbezogenen Daten von ihnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy: everything stays on the device. No accounts, no ads, no tracking. The app is also meant for children under 13 and collects no personal data from them."
          }
        }
      }
    },
    "Datenschutzerklärung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy policy"
          }
        }
      }
    },
    "Dauer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration"
          }
        }
      }
    },
    "Dazu gibt es kein Video.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no video for that."
          }
        }
      }
    },
    "Dein Wunsch ist bei deinen Eltern. ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wish is with your parents. "
          }
        }
      }
    },
    "Deine Eltern haben noch nichts ausgesucht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your parents have not picked anything yet."
          }
        }
      }
    },
    "Deine Eltern haben von hier noch kein Video ausgesucht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your parents have not picked a video from here yet."
          }
        }
      }
    },
    "Deine Eltern können hier %@ für dich aussuchen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your parents can pick %@ for you here."
          }
        }
      }
    },
    "Deine Eltern können hier Kanäle für dich aussuchen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your parents can pick channels for you here."
          }
        }
      }
    },
    "Deine Eltern richten SideTube erst noch ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your parents are still setting up SideTube."
          }
        }
      }
    },
    "Deine Eltern: „%@“": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your parents: “%@”"
          }
        }
      }
    },
    "Deine Zeit für heute ist um. Morgen geht es weiter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your time for today is up. It continues tomorrow."
          }
        }
      }
    },
    "Den Code erzeugt das Skript `talk-wunschkanal.sh` auf dem Server der Familie (Nextcloud mit Talk).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is created by the script `talk-wunschkanal.sh` on the family’s server (Nextcloud with Talk)."
          }
        }
      }
    },
    "Der Einrichtungscode passt nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setup code does not match."
          }
        }
      }
    },
    "Der Filter hat eindeutig nicht kindgerechte Begriffe erkannt – keine Freigabe möglich.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter found clearly unsuitable terms – approval is not possible."
          }
        }
      }
    },
    "Der Filter hat eindeutig nicht kindgerechte Begriffe im Titel erkannt – keine Freigabe möglich.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter found clearly unsuitable terms in the title – approval is not possible."
          }
        }
      }
    },
    "Der Kanal kommt nicht in die Liste; künftige Links dieses Kanals werden abgewiesen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The channel is not added to the list; future links from this channel are rejected."
          }
        }
      }
    },
    "Der Schlüssel wird von diesem Gerät gelöscht. Bot und Gespräch auf der Nextcloud bleiben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is deleted from this device. Bot and conversation on the Nextcloud remain."
          }
        }
      }
    },
    "Der eingebettete YouTube-Player kann am Ende oder in der Pause Vorschläge aus demselben Kanal zeigen; das lässt sich technisch nicht abschalten. Deshalb gilt: Für das freie Stöbern nur vollständig kindorientierte Quellen, alles andere Video für Video. Und: Kein Filter ersetzt das Gespräch. Schaut hin und wieder gemeinsam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embedded YouTube player may show suggestions from the same channel at the end or while paused; this cannot be switched off technically. So: for free browsing only fully child-oriented sources, everything else video by video. And: no filter replaces the conversation. Watch together now and then."
          }
        }
      }
    },
    "Derbe Sprache": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coarse language"
          }
        }
      }
    },
    "Die Eingaben stimmen nicht überein. Bitte erneut beginnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entries do not match. Please start again."
          }
        }
      }
    },
    "Die Einträge verschwinden aus der Whitelist von %@. Freigegebene Inhalte bleiben unberührt; ein Startpaket lässt sich jederzeit erneut laden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entries disappear from the whitelist of %@. Approved content is untouched; a starter pack can be loaded again at any time."
          }
        }
      }
    },
    "Die Instanz wird mit der Stufe „nur einzeln geprüfte Videos“ angelegt. Für eine eigene Familien-Instanz kann die Stufe danach erhöht werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The instance is created with the level “individually reviewed videos only”. For your own family instance the level can be raised afterwards."
          }
        }
      }
    },
    "Die PIN konnte nicht sicher gespeichert werden. Bitte versuche es erneut.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN could not be saved securely. Please try again."
          }
        }
      }
    },
    "Die PIN schützt den Elternbereich. Mindestens %lld Ziffern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN protects the parent area. At least %lld digits."
          }
        }
      }
    },
    "Die PIN schützt die Einstellungen. Mindestens %lld Ziffern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN protects the settings. At least %lld digits."
          }
        }
      }
    },
    "Die Schlafzeit ist da. Bis morgen!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s sleep time. See you tomorrow!"
          }
        }
      }
    },
    "Die Sehzeit konnte nicht gespeichert werden. Bitte die Eltern fragen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch time could not be saved. Please ask your parents."
          }
        }
      }
    },
    "Die Suche nutzt das YouTube-Kontingent. Für einzelne Kanäle ist „Link hinzufügen“ sparsamer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search uses the YouTube quota. For single channels, “Add link” is more economical."
          }
        }
      }
    },
    "Die Zeit ist um": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time's up"
          }
        }
      }
    },
    "Die letzte Wiedergabe wurde nicht sicher beendet. Bereits gespeicherte Sehzeit bleibt erhalten; fehlende Zeit wird nicht geschätzt. Bitte die Eltern fragen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last playback was not ended safely. Watch time already saved is kept; missing time is not estimated. Please ask your parents."
          }
        }
      }
    },
    "Die neue PIN konnte nicht sicher gespeichert werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new PIN could not be saved securely."
          }
        }
      }
    },
    "Die neue PIN stimmte nicht überein. Bitte erneut eingeben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new PIN did not match. Please enter it again."
          }
        }
      }
    },
    "Diese Kanäle stehen in einer Whitelist, aber nicht im Quellenregister – etwa von einem anderen Gerät übernommen. Ohne Einstufung zeigt SideTube daraus nur einzeln freigegebene Videos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These channels are on a whitelist but not in the source registry – for example taken over from another device. Without a rating, SideTube shows only individually approved videos from them."
          }
        }
      }
    },
    "Diese PeerTube-Instanz ist nicht freigegeben. Eltern können sie unter „Quellen & Sicherheitsstufen“ ergänzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PeerTube instance is not approved. Parents can add it under “Sources & safety levels”."
          }
        }
      }
    },
    "Diese Playlist ist leer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This playlist is empty."
          }
        }
      }
    },
    "Diese Quelle ist für Kinder gesperrt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source is blocked for children."
          }
        }
      }
    },
    "Diese Sendung haben deine Eltern nicht ausgesucht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your parents did not pick this show."
          }
        }
      }
    },
    "Diese Videos gehen gerade nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These videos are not working right now."
          }
        }
      }
    },
    "Dieser Kanal ist nicht im SideTube-Quellenregister. Mit einem API-Schlüssel kann die allgemeine YouTube-Suche verwendet werden; sonst bitte die Kanaladresse einfügen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This channel is not in the SideTube source registry. With an API key the general YouTube search can be used; otherwise please paste the channel address."
          }
        }
      }
    },
    "Dieses Video ist auf der Instanz als nicht jugendfrei gekennzeichnet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video is marked as not suitable for minors on the instance."
          }
        }
      }
    },
    "Drehen, links und rechts: Auswahl in der Reihe. Oben und unten: Reihe wechseln. Mitte: öffnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn, left and right: move within the row. Up and down: switch rows. Center: open."
          }
        }
      }
    },
    "Ein Drehrad zum Auswählen mit dem Daumen, wie am Sidephone. Ist es aus, gibt es im Kindermodus weder Griff noch Knopf dafür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wheel for choosing with the thumb, like on the Sidephone. When it is off, kid mode shows neither handle nor button for it."
          }
        }
      }
    },
    "Ein Kandidat erscheint erst nach eurer Freigabe in der Prüfliste für das Kind. „Vertrauenswürdige Reihe“ zeigt neue Folgen gesperrt zum Wünschen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A candidate appears for the child only after your approval in the review list. “Trusted series” shows new episodes locked, available for wishes."
          }
        }
      }
    },
    "Eine neue Folge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new episode"
          }
        }
      }
    },
    "Eingerichtet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up"
          }
        }
      }
    },
    "Eingerichtet. Mit „Test senden“ prüfen, ob die Meldung ankommt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up. Use “Send test” to check that the message arrives."
          }
        }
      }
    },
    "Einordnung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classification"
          }
        }
      }
    },
    "Einrichten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up"
          }
        }
      }
    },
    "Einrichtungscode scannen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan setup code"
          }
        }
      }
    },
    "Einstellungen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "Einstellungen öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "Einstufen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate"
          }
        }
      }
    },
    "Einstufen und aufnehmen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate and add"
          }
        }
      }
    },
    "Eltern benachrichtigen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify parents"
          }
        }
      }
    },
    "Eltern können in den Einstellungen Kanäle freigeben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parents can approve channels in Settings."
          }
        }
      }
    },
    "Eltern legen in den Einstellungen ein Profil und eine Whitelist an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parents create a profile and a whitelist in Settings."
          }
        }
      }
    },
    "Eltern stellen pro Kind eine Whitelist aus YouTube-Kanälen, -Videos und -Playlists zusammen. Im Kindermodus gibt es nur diese Inhalte – ohne Empfehlungen, Kommentare oder Werbung-Links. Alles bleibt auf diesem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parents build a whitelist of YouTube channels, videos and playlists for each child. Kid mode shows only these – no recommendations, comments or ad links. Everything stays on this device."
          }
        }
      }
    },
    "Eltern-PIN eingeben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter parent PIN"
          }
        }
      }
    },
    "Eltern-PIN festlegen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set parent PIN"
          }
        }
      }
    },
    "Elternbereich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parent area"
          }
        }
      }
    },
    "Elternbereich öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open parent area"
          }
        }
      }
    },
    "Empfehlen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommend"
          }
        }
      }
    },
    "Empfehlung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendation"
          }
        }
      }
    },
    "Empfohlenes Video": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended video"
          }
        }
      }
    },
    "Ende": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End"
          }
        }
      }
    },
    "Entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "Entfernt. SideTube meldet keine Wünsche mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed. SideTube no longer reports wishes."
          }
        }
      }
    },
    "Erledigt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Erst im Elternbereich ein Profil anlegen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a profile in the parent area first."
          }
        }
      }
    },
    "Erst in den Einstellungen ein Profil anlegen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a profile in Settings first."
          }
        }
      }
    },
    "Erst zur Prüfung merken": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save for review"
          }
        }
      }
    },
    "Erwähnt": {
