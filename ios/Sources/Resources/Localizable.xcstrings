    "%@: %lld Kandidaten zur Prüfung für %@ übernommen, %lld bereits vorhanden, %lld aus gesperrten Quellen übersprungen.%@ Freigabe unter „Freigaben prüfen“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld candidates added for review for %@, %lld already present, %lld skipped from blocked sources.%@ Approve under “Review approvals”."
          }
        }
      }
    },
